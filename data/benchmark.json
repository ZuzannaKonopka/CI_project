[
  {
    "id": "P01",
    "split": "dev",
    "operators": [
      "seq",
      "xor",
      "and"
    ],
    "description": "A candidate submits a CV. Then HR performs a preliminary screening. If the screening is positive, a technical interview and an interview with the manager are held; if it is negative, the application is rejected. Both interviews can take place in any order. Each interview ends with a positive or negative assessment. The candidate receives an offer only if both assessments are positive; otherwise the application is rejected.",
    "reference": {
      "process_name": "recruitment",
      "tree": {
        "op": "seq",
        "children": [
          {
            "activity": "submit CV"
          },
          {
            "op": "xor",
            "children": [
              {
                "op": "seq",
                "children": [
                  {
                    "activity": "screening negative"
                  },
                  {
                    "activity": "reject candidate"
                  }
                ]
              },
              {
                "op": "seq",
                "children": [
                  {
                    "activity": "screening positive"
                  },
                  {
                    "op": "xor",
                    "children": [
                      {
                        "op": "seq",
                        "children": [
                          {
                            "op": "and",
                            "children": [
                              {
                                "activity": "technical interview positive"
                              },
                              {
                                "activity": "manager interview positive"
                              }
                            ]
                          },
                          {
                            "activity": "make offer"
                          }
                        ]
                      },
                      {
                        "op": "seq",
                        "children": [
                          {
                            "op": "and",
                            "children": [
                              {
                                "activity": "technical interview positive"
                              },
                              {
                                "activity": "manager interview negative"
                              }
                            ]
                          },
                          {
                            "activity": "reject candidate"
                          }
                        ]
                      },
                      {
                        "op": "seq",
                        "children": [
                          {
                            "op": "and",
                            "children": [
                              {
                                "activity": "technical interview negative"
                              },
                              {
                                "activity": "manager interview positive"
                              }
                            ]
                          },
                          {
                            "activity": "reject candidate"
                          }
                        ]
                      },
                      {
                        "op": "seq",
                        "children": [
                          {
                            "op": "and",
                            "children": [
                              {
                                "activity": "technical interview negative"
                              },
                              {
                                "activity": "manager interview negative"
                              }
                            ]
                          },
                          {
                            "activity": "reject candidate"
                          }
                        ]
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    "notes": "Exact language needs duplicated labels: the final decision depends on both interview outcomes. In the tree the outcome combination is chosen as one XOR, so the trace language is exact but the moment of choice differs from the text."
  },
