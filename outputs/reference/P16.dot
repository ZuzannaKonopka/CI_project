digraph "P16" {
  rankdir=LR;
  node [fontname="Helvetica"];
  "i" [shape=circle, width=0.35, fixedsize=true, label="&#9679;", fontsize=18];
  "o" [shape=circle, width=0.35, fixedsize=true, peripheries=2, label=""];
  "p0" [shape=circle, width=0.35, fixedsize=true, label=""];
  "p1" [shape=circle, width=0.35, fixedsize=true, label=""];
  "p2" [shape=circle, width=0.35, fixedsize=true, label=""];
  "p3" [shape=circle, width=0.35, fixedsize=true, label=""];
  "t0" [shape=box, style=rounded, label="search catalogue"];
  "t1" [shape=box, style=filled, fillcolor=black, label="", width=0.15, height=0.45];
  "t2" [shape=box, style=rounded, label="reserve book"];
  "t3" [shape=box, style=rounded, label="receive notification"];
  "t4" [shape=box, style=rounded, label="borrow book"];
  "t5" [shape=box, style=rounded, label="return book"];
  "i" -> "t0";
  "t0" -> "p0";
  "p0" -> "t1";
  "t1" -> "p1";
  "p0" -> "t2";
  "t2" -> "p2";
  "p2" -> "t3";
  "t3" -> "p1";
  "p1" -> "t4";
  "t4" -> "p3";
  "p3" -> "t5";
  "t5" -> "o";
}