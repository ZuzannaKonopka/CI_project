digraph "P12" {
  rankdir=LR;
  node [fontname="Helvetica"];
  "i" [shape=circle, width=0.35, fixedsize=true, label="&#9679;", fontsize=18];
  "o" [shape=circle, width=0.35, fixedsize=true, peripheries=2, label=""];
  "p0" [shape=circle, width=0.35, fixedsize=true, label=""];
  "p1" [shape=circle, width=0.35, fixedsize=true, label=""];
  "p2" [shape=circle, width=0.35, fixedsize=true, label=""];
  "p3" [shape=circle, width=0.35, fixedsize=true, label=""];
  "t0" [shape=box, style=rounded, label="request return"];
  "t1" [shape=box, style=rounded, label="reject return"];
  "t2" [shape=box, style=rounded, label="approve return"];
  "t3" [shape=box, style=rounded, label="ship product back"];
  "t4" [shape=box, style=rounded, label="inspect product"];
  "t5" [shape=box, style=rounded, label="issue refund"];
  "t6" [shape=box, style=rounded, label="send replacement"];
  "i" -> "t0";
  "t0" -> "p0";
  "p0" -> "t1";
  "t1" -> "o";
  "p0" -> "t2";
  "t2" -> "p1";
  "p1" -> "t3";
  "t3" -> "p2";
  "p2" -> "t4";
  "t4" -> "p3";
  "p3" -> "t5";
  "t5" -> "o";
  "p3" -> "t6";
  "t6" -> "o";
}